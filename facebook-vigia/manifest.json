{
  "manifest_version": 3,
  "name": "Vigía de pegas — Facebook",
  "version": "2.0.0",
  "description": "Mira tus grupos buscando quién pide eléctrico o gasfíter, con ritmo de persona y pausas de seguridad. Tú respondes.",
  "icons": { "16": "iconos/16.png", "32": "iconos/32.png", "48": "iconos/48.png", "128": "iconos/128.png" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs", "notifications"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://aiplatform.googleapis.com/*",
    "https://ntfy.sh/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Vigía de pegas — abrir panel",
    "default_icon": { "16": "iconos/16.png", "32": "iconos/32.png", "48": "iconos/48.png" }
  }
}
